{
  "name": "foundry",
  "version": "0.0.0",
  "private": true,
  "description": "Heisler Studio monorepo — Expo apps and the packages they share",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml}": "prettier --write"
  }
}
